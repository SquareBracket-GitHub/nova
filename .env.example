# Local Node.js execution example. Docker Compose overrides DB_HOST to `db`.
BOT_ENV=test
NODE_ENV=development

TOKEN=your-test-discord-bot-token
CLIENT_ID=your-test-discord-application-id
COMMAND_MODE=GUILD
GUILD_ID=your-test-guild-id

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nova_test
DB_PW=change-me
DB_NAME=nova_test
